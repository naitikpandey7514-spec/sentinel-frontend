FILE: src\index.css
============================================================

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;
}

body {
  background: #f4f7fb;
  color: #172033;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

a {
  color: inherit;
  text-decoration: none;
}

/* Layout */

.app-layout {
  min-height: 100vh;
  display: flex;
  background: #f4f7fb;
}

.sidebar {
  width: 250px;
  min-height: 100vh;
  background: #101827;
  color: #ffffff;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
}

.main-content {
  margin-left: 250px;
  width: calc(100% - 250px);
  min-height: 100vh;
}

.content-area {
  padding: 28px;
}

/* Sidebar */

.sidebar-brand {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 25px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.brand-icon {
  width: 42px;
  height: 42px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1d293d;
}

.sidebar-brand h2 {
  margin: 0;
  font-size: 19px;
}

.sidebar-brand span {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  color: #91a0b8;
}

.sidebar-nav {
  padding: 18px 12px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  color: #9eabc0;
  border-radius: 9px;
  font-size: 14px;
  transition: 0.2s;
}

.nav-item:hover {
  background: #182337;
  color: #ffffff;
}

.nav-item.active {
  background: #24344e;
  color: #ffffff;
}

.sidebar-footer {
  margin-top: auto;
  padding: 18px;
  color: #8492aa;
  font-size: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* Top bar */

.topbar {
  height: 74px;
  background: #ffffff;
  border-bottom: 1px solid #e4e9f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28px;
}

.topbar h1 {
  margin: 0;
  font-size: 18px;
}

.topbar p {
  margin: 4px 0 0;
  font-size: 12px;
  color: #78869b;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: #526075;
}

.online-dot,
.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  background: #24a86b;
}

.live-dot {
  animation: pulse 1.6s infinite;
}

/* Pages */

.page {
  max-width: 1500px;
  margin: 0 auto;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}

.page-header h2 {
  margin: 0;
  font-size: 25px;
  letter-spacing: -0.4px;
}

.page-header p {
  margin: 6px 0 0;
  color: #78869b;
  font-size: 13px;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.title-row svg {
  color: #45698f;
}

/* Buttons */

.refresh-button,
.back-button,
.view-button,
.view-camera-button {
  border: 1px solid #dce3ed;
  background: #ffffff;
  color: #334155;
  border-radius: 8px;
  min-height: 38px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
}

.refresh-button:hover,
.back-button:hover,
.view-button:hover {
  background: #f4f7fb;
}

.view-camera-button {
  width: 100%;
  background: #17263b;
  color: #ffffff;
  border-color: #17263b;
}

.view-camera-button:hover {
  background: #233752;
}

/* Dashboard */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 20px;
}

.dashboard-stat-card {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.dashboard-stat-card .stat-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dashboard-stat-card span {
  display: block;
  color: #7b8798;
  font-size: 12px;
}

.dashboard-stat-card strong {
  display: block;
  margin-top: 5px;
  font-size: 24px;
}

.stat-blue .stat-icon {
  background: #eaf1f8;
}

.stat-green .stat-icon {
  background: #e8f7ef;
}

.stat-red .stat-icon {
  background: #fbecec;
}

.stat-purple .stat-icon {
  background: #f0ecfa;
}

.dashboard-status,
.event-live-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  padding: 8px 11px;
  border-radius: 7px;
  color: #59677b;
  font-size: 12px;
  margin-bottom: 18px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 18px;
}

.dashboard-panel,
.event-stream-panel {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  overflow: hidden;
}

.panel-header,
.event-stream-header {
  padding: 18px 20px;
  border-bottom: 1px solid #edf0f4;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-header h3,
.event-stream-header h3 {
  margin: 0;
  font-size: 15px;
}

.panel-header p {
  margin: 4px 0 0;
  color: #8994a5;
  font-size: 11px;
}

.event-list {
  padding: 4px 20px;
}

.event-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #edf0f4;
}

.event-row:last-child {
  border-bottom: 0;
}

.event-indicator {
  width: 8px;
  height: 8px;
  background: #4d769c;
  border-radius: 50%;
}

.event-info {
  flex: 1;
}

.event-info strong,
.event-info span {
  display: block;
}

.event-info strong {
  font-size: 13px;
}

.event-info span {
  color: #8994a5;
  margin-top: 3px;
  font-size: 11px;
}

.event-meta {
  text-align: right;
}

.event-meta time {
  display: block;
  color: #8994a5;
  margin-top: 4px;
  font-size: 11px;
}

.severity {
  font-size: 10px;
  color: #526075;
}

.no-alerts {
  min-height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  color: #738096;
}

.no-alerts strong {
  color: #334155;
}

.no-alerts span {
  font-size: 12px;
}

/* Search / filters */

.camera-toolbar,
.event-filters {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 11px;
  padding: 13px;
  display: flex;
  gap: 10px;
  margin-bottom: 18px;
}

.search-box {
  flex: 1;
  min-height: 40px;
  border: 1px solid #dce3ed;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  color: #8290a3;
}

.search-box input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #253247;
}

.filter-buttons {
  display: flex;
  gap: 6px;
}

.filter-button {
  border: 1px solid #dce3ed;
  background: #ffffff;
  border-radius: 7px;
  padding: 0 14px;
  color: #647187;
}

.filter-button.active {
  background: #17263b;
  color: #ffffff;
  border-color: #17263b;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 7px;
  border: 1px solid #dce3ed;
  border-radius: 8px;
  padding: 0 10px;
  color: #748196;
}

.filter-group select {
  border: 0;
  outline: 0;
  background: transparent;
  padding: 10px 3px;
  color: #354257;
}

/* Camera table */

.camera-table-wrapper {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  overflow-x: auto;
}

.camera-table {
  width: 100%;
  border-collapse: collapse;
}

.camera-table th {
  text-align: left;
  padding: 14px 16px;
  background: #f8fafc;
  color: #738096;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}

.camera-table td {
  padding: 14px 16px;
  border-top: 1px solid #edf0f4;
  color: #526075;
  font-size: 12px;
  white-space: nowrap;
}

.camera-name {
  display: flex;
  align-items: center;
  gap: 10px;
}

.camera-name strong,
.camera-name span {
  display: block;
}

.camera-name strong {
  color: #29364a;
  font-size: 13px;
}

.camera-name span {
  color: #8994a5;
  margin-top: 3px;
  font-size: 10px;
}

.camera-icon,
.camera-large-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf3f8;
  color: #466d91;
  border-radius: 8px;
}

.camera-icon {
  width: 34px;
  height: 34px;
}

.camera-large-icon {
  width: 48px;
  height: 48px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 600;
}

.status-badge.online {
  background: #e9f7ef;
  color: #208053;
}

.status-badge.offline {
  background: #fbecec;
  color: #ae4646;
}

.camera-footer {
  padding: 12px 3px;
  display: flex;
  justify-content: space-between;
  color: #8793a5;
  font-size: 11px;
}

/* Camera details */

.camera-detail-title {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-top: 14px;
}

.camera-detail-title h2 {
  margin: 0;
}

.camera-detail-title p {
  margin: 4px 0 0;
}

.camera-detail-layout {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 18px;
}

.camera-view-panel,
.camera-health-panel {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  overflow: hidden;
}

.camera-view-header {
  padding: 13px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #edf0f4;
}

.camera-view-header > div {
  display: flex;
  align-items: center;
  gap: 12px;
}

.live-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #b34b4b;
  font-size: 10px;
  font-weight: 700;
}

.camera-stream {
  min-height: 430px;
  background: #0b111b;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.camera-stream video {
  width: 100%;
  height: 100%;
  min-height: 430px;
  object-fit: contain;
}

.stream-placeholder {
  color: #8592a5;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  text-align: center;
  padding: 30px;
}

.stream-placeholder strong {
  color: #d7dee9;
}

.stream-placeholder span {
  max-width: 360px;
  font-size: 12px;
}

.health-status {
  padding: 15px 20px;
}

.health-grid {
  padding: 0 20px 18px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.health-item {
  border: 1px solid #edf0f4;
  border-radius: 9px;
  padding: 13px;
}

.health-item svg {
  color: #6d8096;
}

.health-item span,
.health-item strong {
  display: block;
}

.health-item span {
  color: #8994a5;
  margin-top: 8px;
  font-size: 10px;
}

.health-item strong {
  margin-top: 3px;
  color: #344156;
  font-size: 13px;
}

.camera-information {
  padding: 18px 20px;
  border-top: 1px solid #edf0f4;
}

.camera-information h4 {
  margin: 0 0 12px;
}

.camera-information div {
  display: flex;
  justify-content: space-between;
  padding: 9px 0;
  border-bottom: 1px solid #f0f2f5;
  font-size: 11px;
}

.camera-information div:last-child {
  border-bottom: 0;
}

.camera-information span {
  color: #8994a5;
}

.camera-events-panel {
  margin-top: 18px;
}

/* Map */

.map-layout {
  display: grid;
  grid-template-columns: 1fr 350px;
  gap: 18px;
}

.map-container,
.map-sidebar {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  overflow: hidden;
}

.map-header,
.map-sidebar-header {
  padding: 16px 18px;
  border-bottom: 1px solid #edf0f4;
  display: flex;
  justify-content: space-between;
}

.map-header strong {
  display: block;
}

.map-header span {
  display: block;
  color: #8994a5;
  margin-top: 4px;
  font-size: 11px;
}

.map-status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #5d6b7e;
  font-size: 11px;
}

.map-area {
  min-height: 620px;
  position: relative;
  overflow: hidden;
  background: #edf2f5;
}

.map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(#d7dfe5 1px, transparent 1px),
    linear-gradient(90deg, #d7dfe5 1px, transparent 1px);
  background-size: 45px 45px;
}

.map-center-label {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  color: #758398;
  pointer-events: none;
}

.map-center-label svg {
  margin-bottom: 8px;
}

.map-center-label strong,
.map-center-label span {
  display: block;
}

.map-center-label span {
  max-width: 250px;
  margin-top: 5px;
  font-size: 11px;
}

.map-marker {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  z-index: 3;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);
}

.map-marker.online {
  background: #278b62;
}

.map-marker.offline {
  background: #b65050;
}

.map-sidebar-header h3 {
  margin: 0;
  font-size: 15px;
}

.map-sidebar-header p {
  margin: 4px 0 0;
  color: #8994a5;
  font-size: 11px;
}

.map-camera-list {
  max-height: 340px;
  overflow-y: auto;
}

.map-camera-item {
  width: 100%;
  border: 0;
  border-bottom: 1px solid #edf0f4;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 15px;
  text-align: left;
}

.map-camera-item:hover,
.map-camera-item.selected {
  background: #f4f7fb;
}

.map-camera-icon {
  width: 32px;
  height: 32px;
  background: #edf3f8;
  color: #52718f;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
}

.map-camera-info {
  flex: 1;
}

.map-camera-info strong,
.map-camera-info span {
  display: block;
}

.map-camera-info strong {
  color: #354156;
  font-size: 12px;
}

.map-camera-info span {
  margin-top: 3px;
  color: #8994a5;
  font-size: 10px;
}

.camera-status-dot,
.connection-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.camera-status-dot.online,
.connection-dot.connected {
  background: #2a9868;
}

.camera-status-dot.offline,
.connection-dot.disconnected {
  background: #b75050;
}

.selected-camera {
  margin: 15px;
  padding: 15px;
  border: 1px solid #dfe6ee;
  border-radius: 9px;
}

.selected-camera-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.selected-camera-title span {
  color: #8994a5;
  font-size: 10px;
}

.selected-camera-title h3 {
  margin: 4px 0 0;
  font-size: 14px;
}

.selected-details {
  margin: 14px 0;
}

.selected-details div {
  display: flex;
  justify-content: space-between;
  padding: 7px 0;
  border-bottom: 1px solid #edf0f4;
  font-size: 10px;
}

.selected-details span {
  color: #8994a5;
}

.selected-details strong {
  color: #3a4659;
}

/* Events */

.event-stream-header {
  padding: 17px 20px;
}

.event-stream-header span {
  color: #8994a5;
  font-size: 11px;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #ad4a4a !important;
  font-size: 10px !important;
  font-weight: 700;
}

.event-stream-list {
  padding: 4px 20px;
}

.event-card {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  padding: 17px 0;
  border-bottom: 1px solid #edf0f4;
}

.event-card:last-child {
  border-bottom: 0;
}

.event-card-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 9px;
  background: #edf3f8;
  color: #52718f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.event-card-main {
  flex: 1;
}

.event-card-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.event-card-title h3 {
  margin: 0;
  font-size: 13px;
}

.event-card-main p {
  margin: 6px 0;
  color: #748196;
  font-size: 11px;
}

.event-card-details {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  color: #8994a5;
  font-size: 10px;
}

.event-card-details strong {
  color: #4b586c;
}

.severity-badge {
  padding: 4px 7px;
  border-radius: 5px;
  font-size: 9px;
}

.severity-high {
  background: #fbeaea;
  color: #a84242;
}

.severity-medium {
  background: #fbf2df;
  color: #a17422;
}

.severity-low {
  background: #e9f5ef;
  color: #2b7d58;
}

.severity-normal {
  background: #edf1f5;
  color: #66758a;
}

.event-card-status {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #3e8a65;
  font-size: 10px;
}

/* Integrations */

.integration-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 18px;
}

.integration-summary-card {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 11px;
  padding: 17px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.summary-icon {
  width: 42px;
  height: 42px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf3f8;
}

.summary-icon.connected {
  background: #e8f6ee;
}

.summary-icon.disconnected {
  background: #faecec;
}

.integration-summary-card span,
.integration-summary-card strong {
  display: block;
}

.integration-summary-card span {
  color: #8994a5;
  font-size: 11px;
}

.integration-summary-card strong {
  margin-top: 4px;
  font-size: 20px;
}

.integration-grid,
.vms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.integration-card,
.vms-card {
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  padding: 19px;
}

.integration-card-top,
.vms-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.integration-icon,
.vms-icon {
  width: 43px;
  height: 43px;
  border-radius: 9px;
  background: #edf3f8;
  color: #52718f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.integration-type {
  color: #8994a5;
  font-size: 10px;
}

.integration-card-content {
  margin-top: 17px;
}

.integration-card-content h3,
.vms-card h3 {
  margin: 5px 0;
  font-size: 16px;
}

.integration-card-content p,
.vms-card p {
  margin: 0;
  color: #7b8798;
  line-height: 1.5;
  font-size: 11px;
}

.integration-card-footer {
  border-top: 1px solid #edf0f4;
  margin-top: 18px;
  padding-top: 13px;
  display: flex;
  justify-content: space-between;
  color: #8994a5;
  font-size: 10px;
}

/* VMS */

.vms-card h3 {
  margin-top: 17px;
}

.vms-details {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid #edf0f4;
}

.vms-details div {
  display: grid;
  grid-template-columns: 20px 1fr auto;
  gap: 7px;
  align-items: center;
  padding: 7px 0;
}

.vms-details svg {
  color: #708096;
}

.vms-details span {
  color: #8994a5;
  font-size: 10px;
}

.vms-details strong {
  color: #3d4a5e;
  font-size: 10px;
}

/* States */

.loading-screen {
  min-height: 280px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12px;
  color: #718096;
}

.empty-state {
  padding: 40px 20px;
  text-align: center;
  color: #8994a5;
}

.empty-state.large {
  min-height: 320px;
  background: #ffffff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.empty-state h3 {
  margin: 12px 0 5px;
  color: #344156;
}

.empty-state p {
  max-width: 450px;
  font-size: 12px;
}

.connection-error {
  background: #fff5f5;
  border: 1px solid #f1d5d5;
  border-radius: 11px;
  padding: 22px;
  display: flex;
  align-items: center;
  gap: 15px;
  color: #a34c4c;
}

.connection-error h3 {
  margin: 0;
  color: #843f3f;
}

.connection-error p,
.connection-error span {
  margin: 5px 0 0;
  color: #9c6969;
  font-size: 12px;
}

.connection-error.compact {
  margin-bottom: 18px;
  padding: 13px 16px;
}

.connection-error.compact strong,
.connection-error.compact span {
  display: block;
}

.icon-button {
  width: 38px;
  height: 38px;
  border: 1px solid #dce3ed;
  border-radius: 8px;
  background: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #526075;
}

/* Animation */

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  50% {
    opacity: 0.35;
  }
}

/* Responsive */

@media (max-width: 1100px) {
  .sidebar {
    width: 210px;
  }

  .main-content {
    margin-left: 210px;
    width: calc(100% - 210px);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid,
  .camera-detail-layout {
    grid-template-columns: 1fr;
  }

  .map-layout {
    grid-template-columns: 1fr;
  }

  .integration-grid,
  .vms-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: static;
    width: 100%;
    min-height: auto;
  }

  .sidebar-nav {
    flex-direction: row;
    overflow-x: auto;
  }

  .nav-item {
    white-space: nowrap;
  }

  .sidebar-footer {
    display: none;
  }

  .app-layout {
    display: block;
  }

  .main-content {
    margin-left: 0;
    width: 100%;
  }

  .content-area {
    padding: 17px;
  }

  .topbar {
    padding: 0 17px;
  }

  .topbar p,
  .system-status {
    display: none;
  }

  .page-header {
    align-items: flex-start;
  }

  .stats-grid,
  .integration-summary,
  .integration-grid,
  .vms-grid {
    grid-template-columns: 1fr;
  }

  .camera-toolbar,
  .event-filters {
    flex-direction: column;
  }

  .filter-buttons {
    overflow-x: auto;
  }

  .map-area {
    min-height: 450px;
  }

  .camera-stream,
  .camera-stream video {
    min-height: 280px;
  }

  .event-card {
    flex-wrap: wrap;
  }
}

